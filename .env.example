# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
SUMMARIZER_MODEL=claude-opus-5-5
SUMMARIZER_EFFORT=medium
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=low
JUDGE_ENABLED=true
MAX_INPUT_CHARS=100000
# One JSON line of metadata per request; empty disables logging
REQUEST_LOG_PATH=logs/requests.jsonl
